สร้างไฟล์  /etc/supervisor/conf.d/laravel-queue.conf :
 
ini  
[program:laravel-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/laravel-app/artisan queue:work redis --queue=default --sleep=3 --tries=3 --max-time=3600
directory=/var/www/laravel-app
user=www-data
numprocs=4
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile=/var/www/laravel-app/storage/logs/queue-worker.log
