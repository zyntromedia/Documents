📅 9. Task Scheduler & Cron Jobs
 
ทำงานซ้ำๆ ให้เป็นอัตโนมัติ — ส่งจดหมายข่าว, สร้างรายงาน, ล้างข้อมูลเก่า
 
📁 สำหรับ Laravel 11/12 —  routes/console.php 
 
php  
<?php

use Illuminate\Support\Facades\Schedule;

Schedule::command('cleanup:old-records')
    ->dailyAt('01:00')
    ->appendOutputTo(storage_path('logs/scheduler-cleanup.log'));

Schedule::command('newsletter:send')
    ->mondays()
    ->at('08:00')
    ->appendOutputTo(storage_path('logs/scheduler-newsletter.log'));

Schedule::command('backup:run')
    ->dailyAt('02:00')
    ->appendOutputTo(storage_path('logs/scheduler-backup.log'));

Schedule::command('backup:clean')
    ->dailyAt('03:00')
    ->appendOutputTo(storage_path('logs/scheduler-backup-clean.log'));
 
 
📁 สำหรับ Laravel 10 หรือเก่ากว่า —  app/Console/Kernel.php 
 
php  
protected function schedule(Schedule $schedule): void
{
    $schedule->command('cleanup:old-records')->dailyAt('01:00');
    $schedule->command('newsletter:send')->mondays()->at('08:00');
    $schedule->command('backup:run')->dailyAt('02:00');
    $schedule->command('backup:clean')->dailyAt('03:00');
}
 
 
