🔐 Option B: Manual Backup Script (ปลอดภัย ไม่มีรหัสในโค้ด)
 
สร้างไฟล์  ~/.my.cnf  ที่บัญชีผู้ใช้เซิร์ฟเวอร์:
 
ini  
[client]
user=laravel_user
password=your_database_password
host=127.0.0.1
 
 
bash  
chmod 600 ~/.my.cnf
 
 
สร้าง  scripts/backup.sh :
 
bash  
#!/bin/bash
set -e

DB_NAME="laravel_db"
BACKUP_DIR="/var/backups/laravel"
RETENTION_DAYS=14
DATE=$(date +%Y%m%d_%H%M%S)

mkdir -p "$BACKUP_DIR"

echo "📦 กำลังสำรองฐานข้อมูล: $DB_NAME"
mysqldump --defaults-extra-file="$HOME/.my.cnf" "$DB_NAME" | gzip > "$BACKUP_DIR/db_$DATE.sql.gz"

echo "🧹 ลบไฟล์สำรองที่เก่ากว่า $RETENTION_DAYS วัน"
find "$BACKUP_DIR" -name "db_*.sql.gz" -mtime +$RETENTION_DAYS -delete

echo "✅ สำรองสำเร็จ: db_$DATE.sql.gz"
exit 0
 
 
ตั้งค่าสิทธิ์และตารางเวลา:
 
bash  
