<?php
namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;
use Carbon\Carbon;

class CleanupOldRecords extends Command
{
    protected $signature = 'cleanup:old-records';
    protected $description = 'Delete old records (older than 90 days)';

    public function handle()
    {
        $this->info('Starting cleanup...');
        
        $count = DB::table('posts')
            ->where('created_at', '<', Carbon::now()->subDays(90))
            ->delete();
        
        $this->info("Deleted {$count} old records.");
        return Command::SUCCESS;
    }
}
 
 
 app/Console/Commands/SendWeeklyNewsletter.php 
 
php  
<?php
namespace App\Console\Commands;

use Illuminate\Console\Command;
use App\Models\User;
use App\Mail\WeeklyNewsletter;
use Illuminate\Support\Facades\Mail;

class SendWeeklyNewsletter extends Command
{
    protected $signature = 'newsletter:send';
    protected $description = 'Send weekly newsletter to subscribers';

    public function handle()
    {
        $this->info('Sending newsletters...');
        
        $users = User::where('subscribed', true)->get();
        
        foreach ($users as $user) {
            Mail::to($user)->queue(new WeeklyNewsletter());
            $this->output->write('.');
        }
        
        $this->newLine();
        $this->info("Sent to {$users->count()} subscribers.");
        return Command::SUCCESS;
    }
}
 
 
Step 2: Define Schedule
 
 app/Console/Kernel.php 
 
php  
<?php
namespace App\Console;

use Illuminate\Console\Scheduling\Schedule;
use Illuminate\Foundation\Console\Kernel as ConsoleKernel;

class Kernel extends ConsoleKernel
{
    protected function schedule(Schedule $schedule): void
    {
        // 🧹 Cleanup old records — daily at 1 AM
        $schedule->command('cleanup:old-records')
            ->dailyAt('01:00')
            ->appendOutputTo(storage_path('logs/scheduler-cleanup.log'));

        // 📧 Weekly newsletter — Monday at 8 AM
        $schedule->command('newsletter:send')
            ->mondays()
            ->at('08:00')
            ->appendOutputTo(storage_path('logs/scheduler-newsletter.log'));

        // 📊 Daily report — daily at 2 AM
        $schedule->command('report:daily')
            ->dailyAt('02:00')
            ->appendOutputTo(storage_path('logs/scheduler-reports.log'));

        // 💾 Database backup — daily at 3 AM
        $schedule->command('backup:run')
            ->dailyAt('03:00')
            ->appendOutputTo(storage_path('logs/scheduler-backup.log'));

        // 🧹 Clean old backups — daily at 4 AM
        $schedule->command('backup:clean')
            ->dailyAt('04:00')
            ->appendOutputTo(storage_path('logs/scheduler-backup-clean.log'));
    }

    protected function commands(): void
    {
        $this->load(__DIR__.'/Commands');
        require base_path('routes/console.php');
    }
}
 
 
